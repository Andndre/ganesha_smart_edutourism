    "directional_transforms": {
        "id->en": [
            {
                "pattern": "\\bDesa Wisata Penglipuran\\b",
                "flags": "gi",
                "replacement": "Penglipuran Tourism Village"
            },
            {
                "pattern": "\\bPura\\s+([A-Z]\\w*(?:\\s+[A-Z]\\w*)*)",
                "flags": "g",
