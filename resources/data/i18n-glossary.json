            },
            {
                "pattern": "\\bDesa\\s+([A-Z]\\w*(?:\\s+[A-Z]\\w*)*)",
                "flags": "g",
                "replacement": "$1 Village"
            }
        ],
        "en->id": [
            {
                "pattern": "\\bPenglipuran Tourism Village\\b",
                "flags": "gi",
                "replacement": "Desa Wisata Penglipuran"
            },
            {
                "pattern": "\\b([A-Z]\\w*(?:\\s+[A-Z]\\w*)*)\\s+Temple\\b",
                "flags": "g",
                "replacement": "Pura $1"
            },
            {
                "pattern": "\\b([A-Z]\\w*(?:\\s+[A-Z]\\w*)*)\\s+Village\\b",
                "flags": "g",
                "replacement": "Desa $1"
            }
        ]
