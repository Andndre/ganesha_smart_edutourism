{
  "name": "Ganesha Smart Edutourism (Laravel 13 - PHP 8.4)",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "../docker-compose.override.yml"
  ],
  "service": "penglipuran-app",
  "runServices": [
    "penglipuran-app",
    "penglipuran-db",
    "penglipuran-redis"
  ],
  "workspaceFolder": "/var/www",
  "shutdownAction": "stopCompose",
  "remoteUser": "root",
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Vite HMR Dev Server",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "remote.extensionKind": {
          "google.google-antigravity": [
            "ui"
          ]
        },
        "Laravel.phpCommand": [
          "php"
        ],
        "Laravel.memoryLimit": "1G",
        "php.validate.executablePath": "/usr/local/bin/php",
        "php.version": "8.4",
        "terminal.integrated.defaultProfile.linux": "bash",
        "intelephense.environment.phpVersion": "8.4.0",
        "intelephense.files.maxSize": 3000000,
        "editor.formatOnSave": true,
        "[php]": {
          "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
        }
      },
      "extensions": [
        "laravel.vscode-laravel",
        "bmewburn.vscode-intelephense-client"
      ]
    }
  },
  "postCreateCommand": "composer install && php artisan storage:link"
}
